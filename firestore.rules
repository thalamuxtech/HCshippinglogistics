rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Highclass Shipping — Firestore Security Rules
// Role-based access control (RBAC) enforced at the database layer.
// Roles: admin | nigeria_office | dispatcher | customer
// This is the equivalent of Postgres Row-Level Security described
// in the implementation plan — even a buggy client cannot read
// records it is not authorized to see.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return isSignedIn() ? userDoc().role : 'anon';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isNigeriaOffice() {
      return role() == 'nigeria_office';
    }

    function isDispatcher() {
      return role() == 'dispatcher';
    }

    function isStaff() {
      return isAdmin() || isNigeriaOffice() || isDispatcher();
    }

    function assignedCountry() {
      return userDoc().assigned_country;
    }

    // ---- users ----
    match /users/{userId} {
      // A user reads their own record. Admin and destination office may read any
      // user (they manage customers). Dispatchers may NOT read customer accounts
      // in bulk — they get the recipient contact they need from the shipment doc.
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isAdmin() || isNigeriaOffice()
      );
      // Anyone signed in can create their OWN user doc (signup); role is
      // constrained to 'customer' at creation to prevent privilege escalation.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'customer';
      // Users can update limited profile fields on their own doc; they may NOT
      // change their role, active/deleted flags, or the access-code material
      // (which is the credential for returning customers).
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.is_active == resource.data.is_active
          && request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
          && request.resource.data.get('access_code_hash', '') == resource.data.get('access_code_hash', '')
          && request.resource.data.get('access_code_salt', '') == resource.data.get('access_code_salt', '')
          && request.resource.data.get('access_code_prefix', '') == resource.data.get('access_code_prefix', ''))
      );
      allow delete: if isAdmin();
    }

    // ---- shipments ----
    match /shipments/{shipmentId} {
      // Customer: only their own. Dispatcher: only assigned to them.
      // Nigeria office: only their assigned destination country.
      // Admin: all.
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.customer_id == request.auth.uid ||
        // Dispatchers see shipments that have reached the destination hand-out
        // stages (grouped by container), plus anything explicitly assigned.
        (isDispatcher() && (
          resource.data.assigned_dispatcher_id == request.auth.uid ||
          resource.data.current_status in ['offloading', 'delivery', 'completed']
        )) ||
        (isNigeriaOffice() && resource.data.destination_country == assignedCountry())
      );
      // Customers may create their own orders; staff may create for anyone.
      allow create: if isSignedIn() && (
        isStaff() ||
        request.resource.data.customer_id == request.auth.uid
      );
      // Admin and destination office may update freely. Dispatchers may only act
      // on the delivery hand-off: they can advance status and raise a release
      // request, but MUST NOT change money or the DNR hold (those stay equal to
      // the stored values). This enforces the hold model server-side.
      allow update: if isAdmin() || (
        // Destination office: only shipments bound for their assigned country,
        // and they may not reassign a shipment out of that country. Same
        // .get() defaulting as the dispatcher branch below, so a doc that omits
        // destination_country fails the country check explicitly instead of
        // silently denying every office write.
        isNigeriaOffice()
        && resource.data.get('destination_country', '') == assignedCountry()
        && request.resource.data.get('destination_country', '') == assignedCountry()
      ) || (
        // Dispatchers must not change money or the DNR hold. Every comparison
        // uses .get(field, default) on BOTH sides: `request.resource.data` is the
        // full post-write document, and most shipment docs legitimately omit
        // these fields (dnr_override is unset until an admin overrides; deposit /
        // balance are absent until a payment is recorded). Comparing two MISSING
        // fields directly does not evaluate true in rules, so the bare `==` form
        // denied every dispatcher write on a normal doc — that is what surfaced
        // as "Could not complete / check your connection" on Mark Delivered.
        isDispatcher()
        && request.resource.data.customer_id == resource.data.customer_id
        && request.resource.data.get('total_price', 0) == resource.data.get('total_price', 0)
        && request.resource.data.get('deposit', 0) == resource.data.get('deposit', 0)
        && request.resource.data.get('balance', 0) == resource.data.get('balance', 0)
        && request.resource.data.get('payment_status', '') == resource.data.get('payment_status', '')
        && request.resource.data.get('dnr', false) == resource.data.get('dnr', false)
        && request.resource.data.get('dnr_override', null) == resource.data.get('dnr_override', null)
      );
      allow delete: if isAdmin();
    }

    // ---- shipment_status_logs (append-only audit trail) ----
    match /shipment_status_logs/{logId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        get(/databases/$(database)/documents/shipments/$(resource.data.shipment_id)).data.customer_id == request.auth.uid
      );
      allow create: if isStaff();
      // Immutable: no updates or deletes, ever.
      allow update, delete: if false;
    }

    // ---- price_list (public read, admin write) ----
    match /price_list/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- site_content (marketing content managed by admin, public read) ----
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- inventory (usa + destination) ----
    // USA warehouse: Admin only per plan (Nigeria office & dispatchers cannot see it).
    match /usa_inventory/{itemId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /destination_inventory/{itemId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isNigeriaOffice() && resource.data.destination_country == assignedCountry())
      );
      allow write: if isAdmin() ||
        (isNigeriaOffice() && request.resource.data.destination_country == assignedCountry());
    }

    // ---- digital_receipts ----
    match /digital_receipts/{receiptId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        get(/databases/$(database)/documents/shipments/$(resource.data.shipment_id)).data.customer_id == request.auth.uid
      );
      allow create, update: if isAdmin() || isNigeriaOffice();
      allow delete: if isAdmin();
    }

    // ---- roro_documents ----
    match /roro_documents/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isNigeriaOffice();
    }

    // ---- sailing_notices ----
    match /sailing_notices/{noticeId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---- notifications log ----
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        isStaff() ||
        resource.data.customer_id == request.auth.uid
      );
      // Staff may log any notification; a customer may log notifications
      // tied to their own account (e.g. order-confirmation record).
      allow create: if isSignedIn() && (
        isStaff() ||
        request.resource.data.customer_id == request.auth.uid
      );
      allow update, delete: if false;
    }

    // ---- activity_log (append-only) ----
    match /activity_log/{logId} {
      allow read: if isAdmin();
      // Signed-in users may append, but only attributed to themselves —
      // prevents forging another user's audit entries. Append-only.
      allow create: if isSignedIn()
                    && request.resource.data.actor_id == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- contact_inquiries (public submit, staff read) ----
    match /contact_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // ---- counters (serial numbers for tracking codes + access codes) ----
    // Any signed-in user needs to increment counters during signup
    // (customer serial) and order creation (shipment serial). The value
    // is a non-secret monotonic integer, so read/write is safe for all
    // authenticated users; server-side receipt counters run via Admin SDK.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- rate_limits (brute-force buckets for the public lookup callables) ----
    // Written ONLY by Cloud Functions via the Admin SDK, which bypasses these
    // rules. No client may read or tamper with the counters.
    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }
  }
}
